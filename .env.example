# Dashboard sign-in (required for /admin).
# Choose something long — this single password gates every product edit.
ADMIN_PASSWORD=change-me

# Optional. Signs the admin session cookie; defaults to ADMIN_PASSWORD, which
# means changing the password signs everyone out. Set this to keep them apart.
ADMIN_SESSION_SECRET=

# Canonical site URL, used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional. Signs customer session cookies. Leave it empty and one is generated
# on first sign-up and kept in data/customers.json — set it explicitly once you
# run more than one instance, or anywhere data/ is not persistent.
CUSTOMER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase — the database and the product-photo bucket.
#
# Leave these empty and the store keeps everything in JSON files under data/,
# which is fine on a server with a real disk and lossy anywhere serverless.
# Setup steps: the Database page in the dashboard, or the README.
# ---------------------------------------------------------------------------

# Project Settings -> API -> Project URL
SUPABASE_URL=

# Project Settings -> API -> service_role key. Server-side only: it bypasses
# every access rule in the database. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for product photos. Create it as a PUBLIC bucket.
SUPABASE_IMAGE_BUCKET=product-images

# ---------------------------------------------------------------------------
# Meta Pixel + Conversions API
#
# The Pixel ID is the only one of these the browser sees. Leave it empty and
# no pixel script loads, nothing is tracked, and the store behaves exactly as
# it did before — which is what you want locally and on preview deploys.
# ---------------------------------------------------------------------------

# Events Manager -> Data sources -> your pixel. Digits only.
NEXT_PUBLIC_META_PIXEL_ID=

# Optional. `required` holds every event back until consent is granted, for a
# cookie banner to release through window.chinexmallPixelConsent.grant().
# Anything else (the default) behaves like Meta's own base code.
NEXT_PUBLIC_META_PIXEL_CONSENT_MODE=

# Optional. `on` logs every event to the browser console. Never on in prod.
NEXT_PUBLIC_META_PIXEL_DEBUG=

# ---- Conversions API (server-side). Never prefix any of these NEXT_PUBLIC_.
#
# Events Manager -> Settings -> Conversions API -> Generate access token.
# This token can write to your ad account's event stream: treat it like a
# password, set it in the host's secret store, and never commit it.
META_CONVERSIONS_API_ACCESS_TOKEN=

# Optional. Graph API version, so a deprecation is a variable change.
# Defaults to v23.0.
META_CONVERSIONS_API_VERSION=

# Optional. While testing: Events Manager -> Test events -> the code shown
# there. Events sent with it appear under Test events instead of live traffic.
META_CONVERSIONS_API_TEST_EVENT_CODE=

# Optional. Mirrors browser ViewContent / AddToCart / InitiateCheckout to the
# Conversions API through /api/meta/events, sharing the browser event_id so
# Meta deduplicates the pair. Both must read `on` for the relay to run.
# Purchase is never relayed from the browser: /api/orders sends it server-side
# from prices the server re-derived, which is the only trustworthy source.
NEXT_PUBLIC_META_CAPI_RELAY=
META_CAPI_RELAY=

# ---------------------------------------------------------------------------
# Order alerts to the shop's phones (Firebase Cloud Messaging)
#
# None of these may be prefixed NEXT_PUBLIC_ — the private key can send a
# notification to every device subscribed to your app. Leave them empty and no
# alert is sent and nothing else changes.
#
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. The downloaded JSON holds all three values.
# ---------------------------------------------------------------------------

# "project_id" from the service account JSON.
FCM_PROJECT_ID=

# "client_email" — ends in .iam.gserviceaccount.com
FCM_CLIENT_EMAIL=

# "private_key". Paste it with the \n escapes intact, in double quotes:
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FCM_PRIVATE_KEY=

# Optional. The FCM topic every staff phone subscribes to. Defaults to "orders".
# Change it and every phone must re-subscribe to the new name.
ORDER_ALERT_TOPIC=

# ---------------------------------------------------------------------------
# Order emails (SMTP)
#
# Two emails go out when an order is placed: a "new order" alert to the shop,
# and a confirmation to the customer when they left an email address. Leave
# these empty and neither is sent and nothing else changes.
#
# These are the Hostinger Email settings. Confirm them for your own mailbox in
# hPanel -> Emails -> your domain -> Email Accounts -> Connect Apps & Devices,
# which also tells you whether the mailbox is Hostinger Email or Titan Mail --
# Titan's outgoing host is smtp.titan.email on the same ports.
#
# This file is COMMITTED. Put real values in .env.local for local development
# and in your host's environment variables for production. Never a password
# here.
# ---------------------------------------------------------------------------

# Hostinger Email: smtp.hostinger.com. Titan Mail: smtp.titan.email.
SMTP_HOST=smtp.hostinger.com

# 465 for implicit TLS -- Hostinger's own guides start here, so prefer it --
# or 587 for STARTTLS if 465 gives you encryption errors. Defaults to 465.
# Port 25 is not supported: the password is never sent in the clear, so a
# server that will not negotiate TLS gets no credentials.
SMTP_PORT=465

# The full mailbox address, which is also the SMTP username. This is the `From`
# on every email too -- a `From` that differs from the authenticating account
# fails DMARC alignment and is the most common reason transactional mail is
# filed as spam.
SMTP_USER=info@chinexmall.com

# That mailbox's password. Belongs in .env.local, never in this file.
SMTP_PASSWORD=

# Optional. Display name shown beside the address. Defaults to the site name.
MAIL_FROM_NAME=ChineXmall

# Optional. Where the "new order" alert lands, if not the address in
# src/lib/site.ts. Accepts one address. Keeping it on the sending domain means
# your mail server delivers the alert locally, which cannot be spam-filed; any
# other domain is an ordinary external delivery.
ORDER_ALERT_EMAIL=
